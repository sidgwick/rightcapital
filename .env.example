# 服务器配置
PORT=1234

# 数据库配置
# 是否使用 MySQL 数据库 (true/false)
USE_MYSQL=false

# MySQL 连接字符串（当 USE_MYSQL=true 时使用）
MYSQL_DSN=notification:password@tcp(localhost:3306)/notification?charset=utf8mb4&parseTime=True&loc=Local

# MQ 配置
MQ_URL=localhost:9092
MQ_TOPIC=notification_callbacks
MQ_CONSUMER_GROUP=notification_system
MQ_RECONNECT_DELAY=5s
